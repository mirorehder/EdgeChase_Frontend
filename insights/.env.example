# Umgebungsvariablen fuer EdgeChase Insights.
#
# Insights liest ausschliesslich - es schreibt weder in Neon noch bei Instagram
# oder Wix. Deshalb reichen Lese-Zugaenge.
#
# ALLE Werte werden im Vercel-Projekt eingetragen, nicht ins Repository.

# --- Neon-Postgres --------------------------------------------------------
# Dieselbe Datenbank wie der Content Generator, aber NUR lesend genutzt.
# Wenn die App als eigenes Vercel-Projekt aufsetzt, "Storage -> Add Neon" und
# hier die von Vercel gesetzte Variable eintragen.
DATABASE_URL=

# --- Instagram Graph-API v21.0 -------------------------------------------
# Je Sparte ein Zugang; posten alle auf dasselbe Konto, reichen die
# allgemeinen IG_TOKEN / IG_USER_ID als Rueckfall. Ohne diese Werte zeigt
# die App fuer eine Sparte einen ehrlichen Leerzustand.
# IG_TOKEN_PROMO=
# IG_USER_ID_PROMO=
# IG_TOKEN_VIRAL=
# IG_USER_ID_VIRAL=
# IG_TOKEN_SPORTS=
# IG_USER_ID_SPORTS=
# IG_TOKEN_CLOTHING=
# IG_USER_ID_CLOTHING=
# IG_TOKEN=
# IG_USER_ID=

# --- Wix REST-API ---------------------------------------------------------
# Site-Level API-Key aus dem Wix-Dashboard, dazu Site- und Account-ID.
# Fehlt einer der drei Werte, wird der Umsatz-Bereich ausgegraut - es wird
# NICHTS geschaetzt.
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# --- Coupon-Generator (getrenntes Vercel-Projekt) -------------------------
# Zugang zur schmalen JSON-Schnittstelle der Coupon-App, die je Video die
# ausgegebenen Rabattcodes kennt (postedMediaId -> [{code, username, name}]).
# Ohne diese Werte bleibt der Promo-Funnel ab "ausgegebene Codes" leer.
# COUPON_API_URL=
# COUPON_API_KEY=
