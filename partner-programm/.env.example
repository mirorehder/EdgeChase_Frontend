# ---------------------------------------------------------------------------
# EdgeChase Partner-Programm — Umgebungsvariablen
#
# EIGENE Konfiguration dieser App. Nichts hier teilt sich mit dem Coupon-
# Automaten: eigenes Vercel-Projekt, eigene Neon-Datenbank, eigene VAPID-
# Schlüssel, eigenes Webhook-Prüfwort.
# ---------------------------------------------------------------------------

# --- Datenbank (eigener Neon-Branch/-Projekt) ---
# Setzt die Neon-Integration in Vercel automatisch (Storage -> Create Database).
# DATABASE_URL = gepoolte Verbindung für die App,
# DATABASE_URL_UNPOOLED = direkte Verbindung für Migrationen (der Pooler lehnt
# die DDL von "prisma migrate deploy" ab).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Gemini ---
# API-Key von ai.google.dev, für Reel-Analyse und Onboarding-Bot.
GEMINI_API_KEY=

# --- Schutz der Verarbeitungs-Route ---
# Frei wählbares Geheimnis. Vercel schickt es dem Zeitplan automatisch als
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Instagram / Meta ---
# Zugriffstoken des EdgeChase-Kontos (Instagram-Login). Dasselbe Konto wie beim
# Coupon-Automaten, hier als eigene Variable.
IG_ACCESS_TOKEN=
# Optional: IG-Kennung des Kontos (Vorgabe steht im Code).
# IG_USER_ID=
# App-Geheimnis der Meta-App (dieselbe App wie der Coupon-Automat). Nur zur
# Signaturprüfung gelesen, nie verändert.
IG_APP_SECRET=
# EIGENES Prüfwort für den EIGENEN Webhook-Endpunkt dieser App. NICHT das des
# Coupon-Automaten wiederverwenden.
IG_WEBHOOK_VERIFY_TOKEN=

# --- Wix ---
# API-Key mit Berechtigung für Gutscheine (derselbe wie beim Coupon-Automaten).
WIX_API_KEY=
# Optional: Site-ID (Vorgabe steht im Code).
# WIX_SITE_ID=
# Geheimnis für den orders/created-Webhook. Der Betreiber trägt es beim
# Einrichten der Wix-Automation in die Webhook-URL ein: .../api/wix-webhook?secret=<WIX_WEBHOOK_SECRET>
WIX_WEBHOOK_SECRET=

# --- Programm-Parameter (optional, mit Vorgaben) ---
# Harte Jahresgrenze der Provision je Person in CHF (Vorgabe 2000).
# JAHRES_DECKEL_CHF=2000
# Mindestbetrag für eine Auszahlung in CHF (Vorgabe 20).
# AUSZAHLUNG_MINDEST_CHF=20
# URL der Teilnahmebedingungen (Vorgabe: /regeln dieser App).
# REGELN_URL=https://edgechase.com/regeln

# --- Web-Push (VAPID) — EIGENE Schlüssel dieser App ---
# Einmal erzeugen (z.B. `npx web-push generate-vapid-keys`) und hier eintragen.
# Public gehört dem Browser (deshalb NEXT_PUBLIC_-Präfix), Private bleibt geheim.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@edgechase.com

# ---------------------------------------------------------------------------
# Content-Generator (in dieser App) — nutzt die BESTEHENDE Infrastruktur des
# Promo-Generators wieder. Am einfachsten: dieselben Werte wie im Hauptprojekt
# (EdgeChase_Frontend) in dieses Vercel-Projekt eintragen.
#
# Bereits oben vorhanden und mitbenutzt: DATABASE_URL(_UNPOOLED), GEMINI_API_KEY,
# CRON_SECRET. Fürs Posten wird ohne weitere Variablen IG_ACCESS_TOKEN dieser
# App genutzt (dasselbe EdgeChase-Konto); ein anderes Ziel via IG_TOKEN/IG_USER_ID.
# ---------------------------------------------------------------------------

# --- Google Drive (Clip-Bibliothek + Zielordner) ---
# Dienstkonto-JSON (einzeilig) mit Zugriff auf die Drive-Ordner.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Quellordner (Shooting-Material) in Drive.
DRIVE_SOURCE_FOLDER_ID=
# Optional: Zielordnername/-ID (sonst legt die App einen an).
# DRIVE_OUTPUT_FOLDER_NAME=EdgeChase Partner Content
# DRIVE_OUTPUT_FOLDER_ID=
# OAuth-Client fürs Herunterladen der fertigen Renders aus Drive.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Remotion Lambda (Rendering, dieselbe Lambda/Site wie das Hauptprojekt) ---
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
# REMOTION_AWS_REGION=eu-central-1

# --- Öffentliche Basis-URL (für Rückmeldungen/öffentliche Video-Kopie) ---
# Vercel setzt VERCEL_PROJECT_PRODUCTION_URL automatisch; nur überschreiben,
# wenn eine feste eigene Domain genutzt wird.
# APP_BASE_URL=https://<diese-app>.vercel.app

# --- Posten (optional, sonst IG_ACCESS_TOKEN von oben) ---
# IG_TOKEN=
# IG_USER_ID=
