# ===========================================================================
# EDGE RUN – Umgebungsvariablen (im Vercel-Projekt unter Settings -> Env Vars)
# ===========================================================================

# --- Pflicht in Produktion -------------------------------------------------
# Geheimnis zum Signieren der Session-Token. Beliebiger langer Zufallsstring.
# Erzeugen z. B.:  openssl rand -base64 32
SESSION_SECRET=

# --- Wix-Coupons (leer lassen = Demo-Modus: Code wird nur angezeigt) --------
# Setzt du beides, erstellt EDGE RUN echte Coupons in Wix.
# >>> In api/lib/wix.js kannst du deinen bereits getesteten Aufruf einsetzen. <<<
WIX_API_KEY=
WIX_SITE_ID=
# Optional: abweichender Endpoint (Standard: Stores v2 Coupons)
# WIX_COUPONS_ENDPOINT=https://www.wixapis.com/stores/v2/coupons

# --- Persistenz für Tageslimit / Replay-Schutz / Jackpot-Deckel -------------
# Ohne diese läuft das Limit nur im Arbeitsspeicher (pro Lambda-Instanz).
# Empfohlen: Vercel -> Storage -> KV (Upstash Redis) anlegen; die Integration
# setzt beide Variablen automatisch.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Ökonomie / Feintuning (alles optional, sonst Defaults) -----------------
# Score-Grenzen der Gewinnstufen (HUD-Distanz).
# REWARD_LOW_MAX=1200
# REWARD_MID_MAX=3500
#
# Gültigkeit der Codes in Tagen.
# COUPON_EXPIRY_DAYS=7
#
# Wie viele Gratis-Teile (Jackpot) höchstens pro Monat vergeben werden dürfen.
# JACKPOT_MAX_PER_MONTH=1
#
# Komplette Belohnungstabellen überschreiben (JSON). Gewichte sind relativ.
# kind: "percent" (value=%), "none" (kein Code), "free" (Gratis-Teil).
# REWARD_TABLE_JSON={"low":[{"kind":"percent","value":10,"weight":75},{"kind":"percent","value":15,"weight":20},{"kind":"none","value":0,"weight":5}],"mid":[{"kind":"percent","value":10,"weight":42},{"kind":"percent","value":15,"weight":38},{"kind":"percent","value":20,"weight":16},{"kind":"percent","value":25,"weight":4}],"high":[{"kind":"percent","value":15,"weight":40},{"kind":"percent","value":20,"weight":34},{"kind":"percent","value":25,"weight":18},{"kind":"percent","value":30,"weight":7.6},{"kind":"free","value":0,"weight":0.4}]}
