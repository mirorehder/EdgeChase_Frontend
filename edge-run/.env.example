# ===========================================================================
# EdgeChase Game – Umgebungsvariablen (im Vercel-Projekt unter Settings -> Env Vars)
# ===========================================================================

# --- Pflicht in Produktion -------------------------------------------------
# Geheimnis zum Signieren der Session-Token. Beliebiger langer Zufallsstring.
# Erzeugen z. B.:  openssl rand -base64 32
SESSION_SECRET=

# --- Wix: Coupons + E-Mail-Versand (ein API-Key für beides) -------------------
# Leer lassen = Demo-Modus: Code wird nur angezeigt, nichts angelegt, keine Mail.
# API-Key im Wix API-Keys-Manager anlegen mit den Berechtigungen
#   - Manage Coupons          (Rabattcodes anlegen; Site braucht Wix Stores)
#   - Manage Email Marketing  (Mail mit dem Code versenden)
# Aufrufe: server/wix.js (POST /stores/v2/coupons) und server/mail.js
# (POST /email-transmissions/v1/email-transmissions/send).
WIX_API_KEY=
WIX_SITE_ID=
# Optional: abweichende Endpoints
# WIX_COUPONS_ENDPOINT=https://www.wixapis.com/stores/v2/coupons
# WIX_EMAIL_ENDPOINT=https://www.wixapis.com/email-transmissions/v1/email-transmissions/send

# Tag der Spiel-Coupons in Wix (zum Filtern im Dashboard), Standard: EdgeChase Game
# COUPON_TAG=EdgeChase Game
# Rabatt nur auf den günstigsten Artikel (true, Standard) oder auf den ganzen Warenkorb (false)
# COUPON_LIMITED_TO_ONE_ITEM=true

# Mail-Optionen (alle optional). Ohne Absender-Angaben nutzt Wix den Standard-Absender.
# Die Absenderadresse muss bei Wix als Absender verifiziert sein.
# MAIL_FROM_NAME=EdgeChase
# MAIL_FROM_EMAIL=rabatt@edgechase.com
# MAIL_REPLY_TO=info@edgechase.com
# Team-Adresse(n), Komma-getrennt: bekommen eine Mail, wenn jemand den Hauptpreis
# (Gratis-Teil) gewinnt – der wird NICHT automatisch als Coupon angelegt.
# MAIL_TEAM_TO=team@edgechase.com
# Shop-Link in der Mail
# SHOP_URL=https://www.edgechase.com
# Adresse, unter der das Logo für die Mail liegt (öffentlich erreichbar). Standard: https://edge-run-xi.vercel.app
# Bei einer eigenen Domain für das Spiel hier eintragen.
# ASSET_BASE_URL=https://edge-run-xi.vercel.app

# --- Spiel-Limit je E-Mail-Adresse -----------------------------------------
# off   = kein Limit (NUR zum Testen – jeder Lauf mit Gewinn legt einen echten Coupon an)
# daily = ein Versuch pro Adresse und Tag (Standard)
# once  = ein Versuch pro Adresse, für immer
# Der Versuch wird beim Spielstart belegt, nicht erst bei der Auswertung.
# PLAY_LIMIT=daily
# Test-Zugang: diese Adressen (Komma-getrennt) spielen ohne Limit, z. B. eure eigene.
# Nur für euch – wer die Adresse kennt, kann unbegrenzt spielen.
# PLAY_LIMIT_BYPASS=ich+test-4711@example.com

# --- Persistenz für Tageslimit / Replay-Schutz / Jackpot-Deckel -------------
# Ohne diese läuft das Limit nur im Arbeitsspeicher (pro Lambda-Instanz).
# Empfohlen: Vercel -> Storage -> KV (Upstash Redis) anlegen; die Integration
# setzt beide Variablen automatisch.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Ökonomie / Feintuning (alles optional, sonst Defaults) -----------------
# Rabatt-Leiter: ab `min` Metern gilt `pct` % (Standard: 150→10, 1200→15, 3500→20, 5500→25, 8000→30).
# REWARD_LADDER_JSON=[{"min":150,"pct":10},{"min":1200,"pct":15},{"min":3500,"pct":20},{"min":5500,"pct":25},{"min":8000,"pct":30}]
# Chance auf die nächsthöhere Stufe (Standard 0.15) und Gratis-Teil (Standard 0.004, erst ab REWARD_FREE_MIN=8000 m).
# REWARD_BUMP_CHANCE=0.15
# REWARD_FREE_CHANCE=0.004
# REWARD_FREE_MIN=8000
#
# Codes laufen bewusst NICHT ab (Drop hat noch nicht begonnen); jeder Code ist nur einmal einlösbar.
#
# Wie viele Gratis-Teile (Jackpot) höchstens pro Monat vergeben werden dürfen.
# JACKPOT_MAX_PER_MONTH=1
#
