# Neon Postgres. Beide Variablen setzt die Neon-Integration in Vercel
# (Storage -> Create Database -> Neon) automatisch - dann hier nichts eintragen.
#
# DATABASE_URL ist die gepoolte Verbindung für die Anwendung,
# DATABASE_URL_UNPOOLED die direkte für Migrationen (der Pooler lehnt die
# DDL-Anweisungen von "prisma migrate deploy" ab).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini API-Key (ai.google.dev)
GEMINI_API_KEY=

# Kompletter JSON-Schlüssel des Google-Service-Accounts, als String
# (z.B. `cat key.json | jq -c .` und das Ergebnis hier einfügen).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Wurzelordner des Rohmaterials. Wird REKURSIV durchsucht: alle Unterordner
# (Parkour-Bangers, Roofing Bangers, Trainings-Clips, Shootings, ...) werden
# eingelesen, und der jeweilige Ordnername geht als Themensignal in die
# Clip-Auswahl ein. Muss für die Service-Account-E-Mail freigegeben sein.
# Aktueller Wert = Drive-Ordner "EdgeChase":
DRIVE_SOURCE_FOLDER_ID=1tRFxnaQnUeIiIH_ImKHD5MKsWek-W2Nr

# Zielordner für die fertigen Videos. Die Anwendung legt ihn beim ersten
# Upload selbst an - sie sieht mit dem Bereich drive.file ausschliesslich
# Dateien, die sie selbst erzeugt hat, ein von Hand angelegter Ordner wäre für
# sie unsichtbar. Verschieben lässt er sich hinterher beliebig.
# DRIVE_OUTPUT_FOLDER_NAME=EdgeChase Promo-Videos
#
# Sobald der Ordner existiert, hier seine ID eintragen: dann übersteht die
# Zuordnung auch ein Umbenennen in Drive. Ohne Eintrag wird über den Namen
# gesucht.
DRIVE_OUTPUT_FOLDER_ID=1aSqPZ5EI4dzhLWpkdEZmVNDKhgLk4zoq

# OAuth-Zugangsdaten für den Upload. Dienstkonten haben kein
# Speicherkontingent und können in Drive nichts anlegen - der Upload läuft
# deshalb im Namen des Nutzers.
#
# Client-ID und -Secret stammen aus einem OAuth-Client vom Typ "Desktop-App"
# in der Google Cloud Console. Das Refresh-Token liefert
# "npx tsx scripts/oauth-url.ts".
#
# WICHTIG: Der Zustimmungsbildschirm muss auf "In Produktion" stehen. Im
# Testmodus macht Google das Refresh-Token nach sieben Tagen ungültig.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional: Unterordner, die beim Einlesen übersprungen werden (Komma-Liste).
# Ohne Angabe gilt der Standard "Referenz-Videos,Logos etc." - Referenz-Videos
# enthalten FREMDES Material, das nie in einem eigenen Werbevideo landen darf.
# DRIVE_EXCLUDED_FOLDER_NAMES=Referenz-Videos,Logos etc.

# Frei wählbares Geheimnis, das die Cron-Route schützt. Vercel schickt es
# automatisch als "Authorization: Bearer <CRON_SECRET>" mit, sobald diese
# Variable im Projekt gesetzt ist.
CRON_SECRET=

# AWS-Zugangsdaten eines Nutzers mit Remotion-Lambda-Rechten
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Region, in der die Remotion-Lambda-Funktion und der Bucket liegen
REMOTION_AWS_REGION=eu-central-1

# Name der per `npm run remotion:lambda:deploy-function` angelegten Funktion
REMOTION_LAMBDA_FUNCTION_NAME=

# URL der per `npm run remotion:lambda:deploy-site` veröffentlichten Website
REMOTION_SERVE_URL=

# Nur nötig, falls sich der Bucket-Name nicht zuverlässig aus
# REMOTION_SERVE_URL ableiten lässt.
# REMOTION_LAMBDA_BUCKET_NAME=
