# Neon Postgres. Beide Variablen setzt die Neon-Integration in Vercel
# (Storage -> Create Database -> Neon) automatisch - dann hier nichts eintragen.
#
# DATABASE_URL ist die gepoolte Verbindung für die Anwendung,
# DATABASE_URL_UNPOOLED die direkte für Migrationen (der Pooler lehnt die
# DDL-Anweisungen von "prisma migrate deploy" ab).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini API-Key (ai.google.dev)
GEMINI_API_KEY=

# Kompletter JSON-Schlüssel des Google-Service-Accounts, als String
# (z.B. `cat key.json | jq -c .` und das Ergebnis hier einfügen).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Wurzelordner des Rohmaterials. Wird REKURSIV durchsucht: alle Unterordner
# (Parkour-Bangers, Roofing Bangers, Trainings-Clips, Shootings, ...) werden
# eingelesen, und der jeweilige Ordnername geht als Themensignal in die
# Clip-Auswahl ein. Muss für die Service-Account-E-Mail freigegeben sein.
# Aktueller Wert = Drive-Ordner "EdgeChase":
DRIVE_SOURCE_FOLDER_ID=1tRFxnaQnUeIiIH_ImKHD5MKsWek-W2Nr

# Zielordner für die fertigen Videos. Die Anwendung legt ihn beim ersten
# Upload selbst an - sie sieht mit dem Bereich drive.file ausschliesslich
# Dateien, die sie selbst erzeugt hat, ein von Hand angelegter Ordner wäre für
# sie unsichtbar. Verschieben lässt er sich hinterher beliebig.
# DRIVE_OUTPUT_FOLDER_NAME=EdgeChase Promo-Videos
#
# Sobald der Ordner existiert, hier seine ID eintragen: dann übersteht die
# Zuordnung auch ein Umbenennen in Drive. Ohne Eintrag wird über den Namen
# gesucht.
DRIVE_OUTPUT_FOLDER_ID=1aSqPZ5EI4dzhLWpkdEZmVNDKhgLk4zoq

# --- Doc Meiro Reels (in der Datenbank weiterhin "viral") ----------------
#
# Die Quellordner der viralen Sparte stehen NICHT mehr hier, sondern in der
# Datenbank - sie werden im Dashboard verwaltet (Name, Beschreibung, und je
# ein Schalter für "analysieren" und "verwenden"). Angelegt werden sie von der
# Migration 20260820100000_source_folders; weitere kommen dort dazu.
#
# Diese Variable ist nur noch der Rückfall, falls für die Sparte gar kein
# Ordner eingetragen ist.
# DRIVE_VIRAL_FOLDER_ID=1t-9kl96htTGEiKqhRiA_Ab9f5T5EpMIN
#
# Die Sparten werden strikt getrennt eingelesen: liegt ein Ordner unterhalb
# eines anderen Wurzelordners, wird er beim Absteigen übersprungen. Ein
# Parkour-Clip kann also nie in einem Werbevideo landen und umgekehrt.

# Rückfallordner der viralen Sparte. Wird im Normalfall nicht mehr benutzt:
# alle Parkour-Edits gehen nach DRIVE_VIRAL_POST_FOLDER_ID (siehe unten).
# DRIVE_VIRAL_OUTPUT_FOLDER_NAME=EdgeChase Virale Edits
# DRIVE_VIRAL_OUTPUT_FOLDER_ID=

# Textgestaltung aller Parkour-Edits - gilt für Zeitplan wie Handauslösung.
# Ohne Eintrag gilt "rund-baloo". Möglich sind ausserdem "rund-nunito",
# "rund-quicksand" und "rund-fredoka"; alle sind weiss mit leichter schwarzer
# Kontur, mittig knapp oberhalb der Bildmitte, und unterscheiden sich nur in
# der Schrift.
# VIRAL_TEXT_STYLE=rund-baloo

# Ordner für ALLE Edits der Doc-Meiro-Sparte - die Liste dessen, was noch
# gepostet werden soll. Gilt für den Zeitplan wie für die Handauslösung im
# Dashboard. Ohne Eintrag gilt der Ordner "Not posted yet"
# (1gCQ-WHW1qKW3_nLgLxjT3Ty3askP2mIQ), der im Code hinterlegt ist.
#
# Dieser Ordner stammt vom Nutzer, nicht von der Anwendung. Mit dem Bereich
# drive.file kann sie ihn nicht lesen (files.get antwortet mit 404), aber sehr
# wohl Dateien darin anlegen und die eigenen darin wiederfinden - an der echten
# Ablage geprüft.
# DRIVE_VIRAL_POST_FOLDER_ID=1gCQ-WHW1qKW3_nLgLxjT3Ty3askP2mIQ

# --- Die beiden EdgeChase-Sparten ----------------------------------------
#
# Ihre Quellordner stehen ebenfalls in der Datenbank: der Sports-Ordner kommt
# aus der Migration 20260823100000_vier_sparten, der Clothing-Ordner aus
# 20260823120000_clothing_ordner. Weitere lassen sich im Dashboard aufnehmen,
# ohne Migration.
#
# In Drive haben die beiden noch keinen Zielordner. Sie legen sich beim ersten
# Video selbst einen an, benannt nach der Sparte; verschieben und umbenennen
# lässt er sich danach beliebig. Nur wenn es ein ganz bestimmter sein soll,
# hier eine ID eintragen:
# DRIVE_SPORTS_OUTPUT_FOLDER_NAME=EdgeChase Sports Reels
# DRIVE_SPORTS_OUTPUT_FOLDER_ID=
# DRIVE_CLOTHING_OUTPUT_FOLDER_NAME=EdgeChase Clothing Reels
# DRIVE_CLOTHING_OUTPUT_FOLDER_ID=

# OAuth-Zugangsdaten für den Upload. Dienstkonten haben kein
# Speicherkontingent und können in Drive nichts anlegen - der Upload läuft
# deshalb im Namen des Nutzers.
#
# Client-ID und -Secret stammen aus einem OAuth-Client vom Typ "Desktop-App"
# in der Google Cloud Console. Das Refresh-Token liefert
# "npx tsx scripts/oauth-url.ts".
#
# WICHTIG: Der Zustimmungsbildschirm muss auf "In Produktion" stehen. Im
# Testmodus macht Google das Refresh-Token nach sieben Tagen ungültig.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional: Unterordner, die beim Einlesen übersprungen werden (Komma-Liste).
# Ohne Angabe gilt der Standard "Referenz-Videos,Logos etc." - Referenz-Videos
# enthalten FREMDES Material, das nie in einem eigenen Werbevideo landen darf.
# DRIVE_EXCLUDED_FOLDER_NAMES=Referenz-Videos,Logos etc.

# Frei wählbares Geheimnis, das die Cron-Route schützt. Vercel schickt es
# automatisch als "Authorization: Bearer <CRON_SECRET>" mit, sobald diese
# Variable im Projekt gesetzt ist.
CRON_SECRET=

# Nur zur Anzeige im Dashboard: wann der tägliche Lauf startet. Der Zeitplan
# selbst steht in vercel.json und lässt sich zur Laufzeit nicht ändern - wird
# er dort verschoben, hier nachziehen.
# CRON_SCHEDULE_LABEL=08:00 UTC

# AWS-Zugangsdaten eines Nutzers mit Remotion-Lambda-Rechten
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Region, in der die Remotion-Lambda-Funktion und der Bucket liegen
REMOTION_AWS_REGION=eu-central-1

# Name der per `npm run remotion:lambda:deploy-function` angelegten Funktion
REMOTION_LAMBDA_FUNCTION_NAME=

# URL der per `npm run remotion:lambda:deploy-site` veröffentlichten Website
REMOTION_SERVE_URL=

# Nur nötig, falls sich der Bucket-Name nicht zuverlässig aus
# REMOTION_SERVE_URL ableiten lässt.
# REMOTION_LAMBDA_BUCKET_NAME=

# Wie viele Clips mindestens im Kandidatenkreis eines Reels stehen.
#
# Ohne Eintrag gilt 15. Die Zahl sagt, wie viele Clips rotieren sollen: ein
# Kreis, der kleiner ist, kann nicht rotieren - dann stehen selbst mit dem
# höchsten Rotationsbonus immer dieselben zur Wahl.
#
# Hochziehen, wenn die Bibliothek wächst. Nach oben deckelt der Wert nichts:
# verlangt ein Konzept mehr Einstellungen, gewinnt die Wunschanzahl plus
# Ersatzleute.
# VIRAL_ROTATION_POOL=15

# In wie viele Teilstücke ein Render zerlegt wird. Ohne Eintrag gilt 20.
#
# Gleichzeitig laufen: die Teilstücke, die steuernde Funktion und jede
# Fortschrittsabfrage - bei 20 also 22. Das setzt voraus, dass das
# Lambda-Kontingent angehoben ist (Service Quotas -> AWS Lambda ->
# "Concurrent executions", L-B99A9384, in der Region der Funktion; die
# Erhöhung ist kostenlos). Faustregel: höchstens Kontingent minus 2.
#
# Beide Richtungen sind gefährlich, deshalb die Vorgeschichte:
#
# Ein frisches AWS-Konto ist auf 10 gleichzeitige Ausführungen gedrosselt. Mit
# dem früheren Wert 8 waren es genau 10 - jeder Render lief an der Kante und
# scheiterte reihenweise an "Concurrency limit reached / Rate Exceeded". Der
# Notbehelf 6 hielt das Kontingent ein, trieb aber die Bilder je Lambda hoch,
# und ab etwa 80 scheitert ein Render bei 4K-Material an
# "Runtime.TruncatedResponse" - über 14 Sekunden Videolänge ging damit nichts
# mehr. Erst das angehobene Kontingent löst die Klemme auf.
#
# Bei 20 passen beide Grenzen bis zu einer Videolänge von 46 Sekunden
# zusammen; darüber warnt die Anwendung im Protokoll.
# REMOTION_MAX_CHUNKS=20
