# Neon Postgres Connection-String
DATABASE_URL=

# Gemini API-Key (ai.google.dev)
GEMINI_API_KEY=

# Kompletter JSON-Schlüssel des Google-Service-Accounts, als String
# (z.B. `cat key.json | jq -c .` und das Ergebnis hier einfügen).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Wurzelordner des Rohmaterials. Wird REKURSIV durchsucht: alle Unterordner
# (Parkour-Bangers, Roofing Bangers, Trainings-Clips, Shootings, ...) werden
# eingelesen, und der jeweilige Ordnername geht als Themensignal in die
# Clip-Auswahl ein. Muss für die Service-Account-E-Mail freigegeben sein.
# Aktueller Wert = Drive-Ordner "EdgeChase":
DRIVE_SOURCE_FOLDER_ID=1tRFxnaQnUeIiIH_ImKHD5MKsWek-W2Nr

# Zielordner für die fertigen Videos. Liegt selbst unter dem Quellordner und
# wird beim Einlesen automatisch übersprungen, damit fertige Videos nicht als
# Rohmaterial zurückkommen. Muss für die Service-Account-E-Mail als Bearbeiter
# freigegeben sein. Aktueller Wert = "Promo-Videos (automatisch erzeugt)":
DRIVE_OUTPUT_FOLDER_ID=1QJCb-tF1TpdXU-lkO0PD1Y2YsVdnTjOr

# Optional: Unterordner, die beim Einlesen übersprungen werden (Komma-Liste).
# Ohne Angabe gilt der Standard "Referenz-Videos,Logos etc." - Referenz-Videos
# enthalten FREMDES Material, das nie in einem eigenen Werbevideo landen darf.
# DRIVE_EXCLUDED_FOLDER_NAMES=Referenz-Videos,Logos etc.

# Frei wählbares Geheimnis, das die Cron-Route schützt. Vercel schickt es
# automatisch als "Authorization: Bearer <CRON_SECRET>" mit, sobald diese
# Variable im Projekt gesetzt ist.
CRON_SECRET=

# AWS-Zugangsdaten eines Nutzers mit Remotion-Lambda-Rechten
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Region, in der die Remotion-Lambda-Funktion und der Bucket liegen
REMOTION_AWS_REGION=eu-central-1

# Name der per `npm run remotion:lambda:deploy-function` angelegten Funktion
REMOTION_LAMBDA_FUNCTION_NAME=

# URL der per `npm run remotion:lambda:deploy-site` veröffentlichten Website
REMOTION_SERVE_URL=

# Nur nötig, falls sich der Bucket-Name nicht zuverlässig aus
# REMOTION_SERVE_URL ableiten lässt.
# REMOTION_LAMBDA_BUCKET_NAME=
