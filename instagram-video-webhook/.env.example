# ─── Instagram / Meta ────────────────────────────────────────────────────────
# App-Secret der Meta-App (Signaturprüfung des Webhook-Payloads via X-Hub-Signature-256)
META_APP_SECRET=

# Selbst gewählter Verify-Token; identisch in der Meta-Webhook-Konfiguration eintragen
IG_WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string

# Langlebiger Instagram-Access-Token (derselbe wie im bestehenden Instagram-MCP)
IG_ACCESS_TOKEN=

# Basis-URL der Graph API. Für Instagram-Login: https://graph.instagram.com/v21.0
# Für Facebook-Login-verknüpfte IG-Accounts: https://graph.facebook.com/v21.0
IG_GRAPH_BASE=https://graph.instagram.com/v21.0

# Nur Videos von diesem Absender-Username werden registriert/analysiert
ALLOWED_SENDER_USERNAME=edgechase.official

# ─── KI-Analyse ──────────────────────────────────────────────────────────────
# Anthropic (Claude) – analysiert Keyframes + Transkript
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Transkription der Audiospur. Default: OpenAI Whisper (whisper-1).
# Leer lassen + TRANSCRIPTION_ENABLED=false für reine Frame-Analyse ohne Transkript.
OPENAI_API_KEY=
TRANSCRIPTION_ENABLED=true
# Optional: alternativer OpenAI-kompatibler Transkriptions-Endpoint (z.B. Groq)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-1

# ─── Interne Verkettung ──────────────────────────────────────────────────────
# Schützt die interne /api/process-Route vor unbefugtem Aufruf
INTERNAL_TASK_SECRET=change-me-to-a-random-string

# Anzahl der aus dem Video extrahierten Keyframes für die Bildanalyse
FRAME_COUNT=6

# ─── Storage: Upstash Redis (Vercel Marketplace) ─────────────────────────────
# Werden automatisch gesetzt, wenn du im Vercel-Dashboard eine Upstash-Redis-
# Integration (Storage → Marketplace) an das Projekt bindest. Für lokales Testen
# aus dem Store kopieren. Beide Namensschemata werden unterstützt.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativ (native Upstash-Namen):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Lese-API (optional) ─────────────────────────────────────────────────────
# Wenn gesetzt, erfordern GET /api/analyses[...] den Header x-api-token bzw. ?token=
READ_API_TOKEN=
