generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrationen müssen an Neons Verbindungspooler vorbei: der läuft im
  // Transaction-Mode und lehnt die DDL-Anweisungen ab, die "prisma migrate
  // deploy" beim Build absetzt. Beide Variablen setzt die Neon-Integration
  // in Vercel automatisch.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Clip {
  id          String @id @default(cuid())
  driveFileId String @unique
  name        String

  durationMs Int?

  /// Ordner, aus dem der Clip stammt. Der Name ("Parkour-Bangers",
  /// "Trainings-Clips", ...) ist ein inhaltliches Signal und geht als
  /// Kontext in die Clip-Auswahl ein.
  sourceFolderId   String?
  sourceFolderName String?

  /// Was auf dem Clip zu sehen ist - Grundlage für die Auswahl.
  description String?

  /// Wie gut die Kleidung erkennbar ist (0-1). Clips, auf denen man nichts
  /// von der Kleidung sieht, taugen für Werbung nicht.
  apparelScore Float?

  /// Bester Ausschnitt für die Verwendung (Millisekunden im Rohclip).
  startMs Int?
  endMs   Int?

  /// Stand der Analyse. Hochzählen, wenn sich Felder oder Prompt ändern -
  /// dann werten sich alte Clips von selbst neu aus.
  analysisVersion Int?

  /// Wann Beschreibung, Bewertung oder Ausschnitt von Hand geändert wurden.
  /// Ist das gesetzt, überspringt die automatische Neuanalyse den Clip - eine
  /// Korrektur des Nutzers soll nicht stillschweigend überschrieben werden.
  editedAt DateTime?

  /// Wann dieser Clip zuletzt in einem Video verwendet wurde. Steuert die
  /// Rotation: lange nicht Verwendetes wird bevorzugt.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([apparelScore])
  @@index([lastUsedAt])
}

/// Laufendes Protokoll dessen, was die Pipeline gerade tut.
///
/// Die Läufe dauern Minuten und laufen serverseitig; ohne diese Einträge
/// sieht die Oberfläche bis zum Schluss gar nichts, und ein nächtlicher
/// Fehlschlag hinterlässt nur eine Fehlermeldung ohne Vorgeschichte.
model ActivityLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  /// info | error
  level   String   @default("info")
  message String
  /// Zugehöriger Job, falls der Eintrag aus einem Video-Auftrag stammt.
  videoId String?

  @@index([at])
}

model PromoVideo {
  id String @id @default(cuid())

  /// Der erzeugte Hook-Text, wie er im Video steht.
  hookText String

  /// Textgestaltung des Overlays: "banner" (kurzer Hook, grosse Schrift) oder
  /// "reference" (laengerer Fliesstext, abgerundete Schrift, starke Kontur).
  /// Leer bedeutet die Voreinstellung.
  textStyle String?

  /// Wortlaut der Anweisung, aus der dieses Video entstanden ist - leer bei
  /// den automatischen Tageslaeufen.
  requestedVia String?

  /// Verwendete Clips in Reihenfolge: [{ clipId, startMs, endMs, seconds }]
  scenes Json

  status   String @default("queued") // queued | rendering | done | failed
  attempts Int    @default(0)

  lastError String?

  claimedAt     DateTime?
  driveUrl      String?
  driveFileName String?

  /// Instagram-Media-ID des geposteten Videos, sobald bekannt.
  ///
  /// Wird von diesem Tool nicht gefüllt - das Posten läuft anderswo. Das
  /// Feld existiert nur, damit eine spätere Auswertung ("welche Clips und
  /// Hook-Texte laufen am besten?") die Kennzahlen einem konkreten Video
  /// zuordnen kann.
  postedMediaId String?
  postedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Vorgaben für den täglichen Lauf. Genau eine Zeile mit fester ID, damit
/// sich die Einstellungen im Dashboard ändern lassen, ohne dass dafür eine
/// neue Fassung ausgerollt werden muss.
model DailyConfig {
  id String @id @default("default")

  /// Fester Text für das Overlay. Leer bedeutet: bei jedem Lauf neu
  /// formulieren lassen.
  hookText String?

  /// "banner" oder "reference".
  textStyle String @default("banner")

  clipCount          Int   @default(4)
  maxSecondsPerScene Float @default(2.5)

  /// Thematischer Wunsch für die Auswahl, z.B. "Parkour". Leer = egal.
  themeHint String?

  /// Steht das auf false, legt der Zeitplan kein Video an.
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}
