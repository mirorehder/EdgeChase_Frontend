generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrationen müssen an Neons Verbindungspooler vorbei: der läuft im
  // Transaction-Mode und lehnt die DDL-Anweisungen ab, die "prisma migrate
  // deploy" beim Build absetzt. Beide Variablen setzt die Neon-Integration
  // in Vercel automatisch.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Die beiden Sparten des Werkzeugs. Sie teilen sich Technik, aber sonst
/// nichts: eigener Drive-Quellordner, eigene Bibliothek, eigene Auswertung,
/// eigener Zielordner. Ein Clip gehoert immer genau einer Sparte an - der,
/// aus deren Ordner er stammt.
///
/// "promo"  - Werbevideos fuer die Kleidung. Bewertet wird, wie gut die
///            Kleidung zu sehen ist.
/// "viral"  - Parkour-Edits. Bewertet wird, wie spektakulaer der Trick ist,
///            und es zaehlt der Moment des Sprungs selbst.
model Clip {
  id          String @id @default(cuid())
  driveFileId String @unique
  name        String

  /// "promo" oder "viral" - siehe oben.
  track String @default("promo")

  durationMs Int?

  /// Ordner, aus dem der Clip stammt. Der Name ("Parkour-Bangers",
  /// "Trainings-Clips", ...) ist ein inhaltliches Signal und geht als
  /// Kontext in die Clip-Auswahl ein.
  sourceFolderId   String?
  sourceFolderName String?

  /// Der im Dashboard verwaltete Wurzelordner, unter dem dieser Clip gefunden
  /// wurde - die Zuordnung, nach der die Bibliothek gruppiert.
  ///
  /// Getrennt von sourceFolderId: der steht für den unmittelbaren Ordner, in
  /// dem die Datei liegt, und der kann ein Unterordner sein. Gruppiert wird
  /// aber nach dem, was im Dashboard als Ordner auftaucht.
  rootFolderId String?

  /// Von Hand vergebener Rang innerhalb des Wurzelordners, 0 ist ganz oben.
  /// Ohne Wert gilt der Clip als unsortiert und zählt hinter allen sortierten.
  manualRank Int?

  /// Von Hand stillgelegt: bleibt in der Bibliothek sichtbar, kommt aber in
  /// keinem Video mehr vor.
  disabled Boolean @default(false)

  /// Was auf dem Clip zu sehen ist - Grundlage für die Auswahl.
  description String?

  /// Nur Sparte "promo": wie gut die Kleidung erkennbar ist (0-1). Clips, auf
  /// denen man nichts von der Kleidung sieht, taugen für Werbung nicht.
  apparelScore Float?

  /// Nur Sparte "viral": wie spektakulär der Trick ist (0-1). 0 heisst, dass
  /// gar kein Trick vorkommt - nur Gehen, Anlauf oder Vorbereitung.
  stuntScore Float?

  /// Nur Sparte "viral": der eigentliche Höhepunkt, in Millisekunden ab
  /// Clipbeginn - vom Absprung bis zur Landung.
  ///
  /// Getrennt von startMs/endMs, weil beides verschiedene Fragen sind: hier
  /// steht, wo der Trick stattfindet, dort, was davon geschnitten wird. Nur
  /// so lässt sich der Schnitt später anders setzen (mehr Anlauf, mehr
  /// Landung), ohne den Clip neu auswerten zu müssen.
  highlightStartMs Int?
  highlightEndMs   Int?

  /// Bester Ausschnitt für die Verwendung (Millisekunden im Rohclip).
  startMs Int?
  endMs   Int?

  /// Stand der Analyse. Hochzählen, wenn sich Felder oder Prompt ändern -
  /// dann werten sich alte Clips von selbst neu aus.
  analysisVersion Int?

  /// Wie oft die Analyse an diesem Clip gescheitert ist, und woran zuletzt.
  ///
  /// Ohne diesen Zähler blockiert ein einziger unverdaulicher Clip die ganze
  /// Warteschlange: die Reihenfolge ist immer dieselbe, also käme er bei jedem
  /// Abgleich wieder als erster dran und scheiterte wieder. Ab drei
  /// Fehlversuchen wird er übersprungen; eine ausdrückliche Neuanalyse setzt
  /// den Zähler zurück.
  analysisFailures Int     @default(0)
  analysisError    String?

  /// Wann Beschreibung, Bewertung oder Ausschnitt von Hand geändert wurden.
  /// Ist das gesetzt, überspringt die automatische Neuanalyse den Clip - eine
  /// Korrektur des Nutzers soll nicht stillschweigend überschrieben werden.
  editedAt DateTime?

  /// Wann dieser Clip zuletzt in einem Video verwendet wurde. Steuert die
  /// Rotation: lange nicht Verwendetes wird bevorzugt.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([apparelScore])
  @@index([lastUsedAt])
  @@index([track])
  @@index([rootFolderId])
}

/// Laufendes Protokoll dessen, was die Pipeline gerade tut.
///
/// Die Läufe dauern Minuten und laufen serverseitig; ohne diese Einträge
/// sieht die Oberfläche bis zum Schluss gar nichts, und ein nächtlicher
/// Fehlschlag hinterlässt nur eine Fehlermeldung ohne Vorgeschichte.
model ActivityLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  /// info | error
  level   String   @default("info")
  /// Sparte, zu der der Eintrag gehört: "promo" oder "viral".
  track   String   @default("promo")
  message String
  /// Zugehöriger Job, falls der Eintrag aus einem Video-Auftrag stammt.
  videoId String?

  @@index([at])
}

model PromoVideo {
  id String @id @default(cuid())

  /// Sparte, aus der dieses Video stammt: "promo" oder "viral".
  track String @default("promo")

  /// Wie dieses Video zustande kam: "scheduled" (der tägliche Zeitplan) oder
  /// "manual" (im Dashboard oder per Dialog ausgelöst).
  ///
  /// Ein eigenes Feld, obwohl es sich heute aus requestedVia und driveFolderId
  /// erraten liesse: die Herkunft ist eine Tatsache über den Auftrag, keine
  /// Nebenwirkung anderer Felder. Wird eines davon später anders belegt,
  /// stimmt die Einteilung sonst stillschweigend nicht mehr.
  origin String @default("manual")

  /// Der erzeugte Hook-Text, wie er im Video steht.
  hookText String

  /// Textgestaltung des Overlays: "banner" (kurzer Hook, grosse Schrift) oder
  /// "reference" (laengerer Fliesstext, abgerundete Schrift, starke Kontur).
  /// Leer bedeutet die Voreinstellung.
  textStyle String?

  /// Wortlaut der Anweisung, aus der dieses Video entstanden ist - leer bei
  /// den automatischen Tageslaeufen.
  requestedVia String?

  /// Lautstaerke des Originaltons der Clips. 0 = stumm, 1 = unveraendert,
  /// darueber wird verstaerkt.
  videoVolume Float @default(1)

  /// Verwendete Clips in Reihenfolge: [{ clipId, startMs, endMs, seconds }]
  scenes Json

  /// Textphasen im fertigen Video: [{ text, startMs, durationMs }].
  /// Leer bedeutet: hookText steht über der ganzen Länge.
  textPhases Json?

  /// Wie die Datei in Drive heissen soll - ein kurzer, treffender Titel zu
  /// genau diesem Video.
  ///
  /// Wird beim Anlegen des Auftrags festgelegt und nicht beim Hochladen: ein
  /// Wiederholversuch muss denselben Namen verwenden, sonst greift der
  /// Duplikatschutz nicht mehr. Leer bedeutet, dass der Hook-Text herhält.
  fileTitle String?

  status   String @default("queued") // queued | rendering | done | failed
  attempts Int    @default(0)

  lastError String?

  claimedAt     DateTime?
  driveUrl      String?
  driveFileName String?

  /// Zielordner in Drive, falls dieser Auftrag nicht in den Standardordner
  /// seiner Sparte gehört. Die vom Zeitplan erzeugten Edits landen so in dem
  /// Ordner, aus dem später gepostet wird, während Handversuche den
  /// Arbeitsordner nicht vollschreiben.
  driveFolderId String?

  /// Instagram-Media-ID des geposteten Videos, sobald bekannt.
  ///
  /// Wird von diesem Tool nicht gefüllt - das Posten läuft anderswo. Das
  /// Feld existiert nur, damit eine spätere Auswertung ("welche Clips und
  /// Hook-Texte laufen am besten?") die Kennzahlen einem konkreten Video
  /// zuordnen kann.
  postedMediaId String?
  postedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([track])
  @@index([origin])
}

/// Vorgaben für den täglichen Lauf. Genau eine Zeile mit fester ID, damit
/// sich die Einstellungen im Dashboard ändern lassen, ohne dass dafür eine
/// neue Fassung ausgerollt werden muss.
model DailyConfig {
  id String @id @default("default")

  /// Fester Text für das Overlay. Leer bedeutet: bei jedem Lauf neu
  /// formulieren lassen.
  hookText String?

  /// "banner" oder "reference".
  textStyle String @default("banner")

  clipCount          Int   @default(4)
  maxSecondsPerScene Float @default(2.5)

  /// Lautstaerke des Originaltons, 0 bis 4.
  videoVolume Float @default(1)

  /// Thematischer Wunsch für die Auswahl, z.B. "Parkour". Leer = egal.
  themeHint String?

  /// Steht das auf false, legt der Zeitplan kein Video an.
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// Ein aus einem fremden Video abgeleitetes Gestaltungskonzept.
///
/// Gespeichert werden ausschliesslich die abgeleiteten Merkmale und der
/// Quelllink - nicht das fremde Video selbst. Es dient der Inspiration, nicht
/// der Weiterverbreitung.
model Concept {
  id    String @id @default(cuid())
  title String

  /// Für welche Sparte diese Vorlage gedacht ist: "promo" oder "viral".
  /// Bei den viralen Edits liefert das Konzept den Text des Videos.
  track String @default("promo")

  /// Link zum urspruenglichen Beitrag, falls mitgeschickt.
  sourceUrl String?

  /// Der Haupttext im Wortlaut - die erste Phase aus textPhases. Bleibt als
  /// eigenes Feld erhalten, weil Listen, Dateinamen und die Promo-Sparte nur
  /// einen einzelnen Text brauchen.
  hookText String

  /// Die Textphasen des Videos in ihrer Reihenfolge, als JSON-Liste:
  /// [{ text, seconds, role, sceneHint }]
  ///
  /// Manche Videos brauchen mehrere Texte nacheinander, damit sie überhaupt
  /// Sinn ergeben - erst ein unterstellter Vorwurf, dann die Antwort, die die
  /// folgende Montage beweist. Ein einziger durchgehender Text kann das nicht
  /// leisten. "role" unterscheidet Aufbau ("setup") von Pointe ("payoff"),
  /// "sceneHint" hält fest, was im Original während dieses Textes zu sehen war
  /// - danach wird der passende eigene Clip gesucht.
  textPhases Json @default("[]")

  /// Welche unserer beiden Textgestaltungen dem Original am naechsten kommt.
  textStyle String @default("reference")

  /// Anzahl der Schnitte bzw. Einstellungen.
  clipCount Int

  totalSeconds    Float
  secondsPerScene Float

  /// Womit sich das Video inhaltlich befasst, in Stichworten.
  theme String?

  /// Beobachtungen zur Schrift, zu Farben und zur Platzierung - als
  /// Gedaechtnisstuetze, nicht maschinell ausgewertet.
  notes String?

  /// Wann zuletzt ein Video nach diesem Konzept entstanden ist. Grundlage der
  /// Rotation: das am längsten nicht verwendete Konzept kommt als nächstes.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Zeitplan der viralen Sparte: was der tägliche Lauf erzeugen soll.
///
/// Genau eine Zeile mit fester ID, wie bei DailyConfig - so lassen sich die
/// Vorgaben im Dashboard ändern, ohne eine neue Fassung auszurollen.
/// Ein Quellordner in Drive, wie ihn das Dashboard verwaltet.
///
/// Bis hierher hatte jede Sparte genau einen Wurzelordner, fest in einer
/// Umgebungsvariablen. Für die Parkour-Edits sind es jetzt mehrere, und welche
/// davon mitlaufen, entscheidet sich zur Laufzeit - deshalb stehen sie in der
/// Datenbank und nicht mehr in der Umgebung.
model SourceFolder {
  id String @id @default(cuid())

  /// Die Ordner-ID aus der Drive-Adresse. Ordner-IDs sind keine Geheimnisse.
  driveFolderId String @unique

  /// Wie der Ordner in Drive heisst. Wird beim Abgleich nachgeführt, damit ein
  /// Umbenennen in Drive im Dashboard ankommt.
  name String

  /// "promo" oder "viral".
  track String @default("viral")

  /// Was für Clips hier liegen und wofür sie taugen - in eigenen Worten.
  /// Geht als Kontext sowohl in die Clip-Analyse als auch in die Auswahl ein.
  description String @default("")

  /// Wird der Ordner eingelesen und ausgewertet? Aus heisst: kein Abgleich,
  /// keine Analyse, keine Gemini-Kosten. Bereits eingelesene Clips bleiben
  /// erhalten und werden beim Aufräumen nicht angefasst.
  autoAnalyze Boolean @default(true)

  /// Dürfen seine Clips in Videos vorkommen? Getrennt vom Auswerten, damit
  /// sich ein fertig analysierter Ordner vorübergehend stilllegen lässt, ohne
  /// die Analyse wegzuwerfen.
  useInVideos Boolean @default(true)

  /// Reihenfolge in der Übersicht.
  sortIndex Int @default(0)

  createdAt DateTime @default(now())

  @@index([track])
}

/// Der Zeitplan einer Sparte. Eine Zeile je Sparte, der Schlüssel ist die
/// Sparte selbst ("viral", "sports", "clothing").
///
/// Die Promo-Sparte hat ihren eigenen Satz Einstellungen (DailySettings) und
/// steht deshalb nicht hier.
model TrackSchedule {
  /// Die Sparte, zu der dieser Zeitplan gehört.
  id String @id

  /// Steht das auf false, erzeugt der Zeitplan keine Edits.
  enabled Boolean @default(false)

  /// Wie viele Edits pro Tag entstehen sollen.
  videosPerDay Int @default(1)

  /// "rotation" = reihum aus allen Konzepten der Sparte.
  /// "fixed"    = nur aus den unter conceptIds gewählten.
  conceptMode String @default("rotation")

  /// Bei "fixed" die gewählten Konzept-IDs als JSON-Liste.
  conceptIds Json @default("[]")

  updatedAt DateTime @updatedAt
}
